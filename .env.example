# ============================================================
# MultiBot — Configuración (variables de entorno)
# Copia este archivo a .env y rellena los valores.
# NUNCA versiones .env. Usa únicamente placeholders en público.
# ============================================================

# Obligatorias — el bot aborta si faltan:
BOT_TOKEN=TU_BOT_TOKEN_DE_BOTFATHER
GROQ_API_KEY=TU_GROQ_API_KEY_FORMATO_GSK

# Opcionales — con valores por defecto en bot/config.py:

# Endpoint de la API TikWM (slides de TikTok y fallbacks).
# TIKWM_API_URL=https://www.tikwm.com/api/

# Base URL de la API de Telegram (útil tras un proxy de Telegram).
# El proxy debe enrutar bot<TOKEN>/<método> como la API oficial.
# BOT_API_BASE_URL=https://api.telegram.org/bot

# Ruta del archivo de sesión de Instagram (Instaloader).
# IG_SESSION=ig_session

# Modelo Groq para /wiki.
# GROQ_MODEL=llama-3.3-70b-versatile

# Temperatura de las respuestas de Groq.
# GROQ_TEMPERATURE=0.3

# Límite de tokens de respuesta de Groq.
# GROQ_MAX_TOKENS=500